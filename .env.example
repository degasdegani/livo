# ──────────────────────────────────────────────────────────────────────────────
# LIVO — Environment Variables Template
# Copy this file to .env and fill in all values before running the app.
# The .env file is in .gitignore and must NEVER be committed to the repository.
# ──────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string.
# Get from: https://console.neon.tech → your project → Connection Details
# Must include ?sslmode=require for production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── AUTHENTICATION ────────────────────────────────────────────────────────────
# NextAuth v5 — secret used to sign JWT tokens and cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — for social login.
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Set authorized redirect URI to: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── EMAIL ─────────────────────────────────────────────────────────────────────
# Resend API key for transactional email (confirmations, invitations).
# Get from: https://resend.com → API Keys
RESEND_API_KEY=""

# Sender address (optional — defaults to noreply@livobarber.com.br)
# RESEND_FROM="noreply@yourdomain.com.br"

# Public URL used in email links (optional — defaults to https://livobarber.com.br)
# NEXTAUTH_URL="https://yourdomain.com.br"

# ── PAYMENTS (ASAAS) ──────────────────────────────────────────────────────────
# Asaas payment gateway API key.
# Production key from: https://www.asaas.com → Minha Conta → Integrações → Chave de API
# Sandbox key from: https://sandbox.asaas.com (for development/staging)
ASAAS_KEY=""

# Asaas webhook authentication token.
# Set this value in Asaas → Minha Conta → Integrações → Webhooks → Autenticação
# The same value must be configured in both Asaas dashboard and this env var.
ASAAS_WEBHOOK_TOKEN=""

# Set to "true" for sandbox/development, "false" for production.
# Controls which Asaas API endpoint is used.
NEXT_PUBLIC_ASAAS_SANDBOX="true"

# ── AI (ANTHROPIC) ────────────────────────────────────────────────────────────
# Anthropic API key for Lívia (AI assistant).
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""

# ── OBSERVABILITY (SENTRY) ────────────────────────────────────────────────────
# Sentry error tracking — optional but strongly recommended in production.
# Create project at: https://sentry.io → Projects → Create Project → Next.js
#
# Server-side DSN (used in Node.js runtime and Edge)
SENTRY_DSN=""
# Client-side DSN (exposed to the browser — safe to be public)
NEXT_PUBLIC_SENTRY_DSN=""
# Organization slug (found in Sentry URL: sentry.io/organizations/YOUR_ORG)
SENTRY_ORG=""
# Project name (defaults to "livo-web" if not set)
SENTRY_PROJECT="livo-web"

# ── SUPPORT ───────────────────────────────────────────────────────────────────
# WhatsApp number for customer support links (format: country+DDD+number, no spaces/dashes)
# Example: 5516999990000 → (16) 99999-0000 → wa.me/5516999990000
SUPPORT_WHATSAPP_NUMBER="5511999999999"

# ── BLOB STORAGE (VERCEL BLOB) ────────────────────────────────────────────────
# Vercel Blob Storage — used for professional profile photos.
# Get from: Vercel Dashboard → Storage → Blob → your store → Token
BLOB_READ_WRITE_TOKEN=""

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Google Maps API key (used for address autocomplete, if enabled)
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
