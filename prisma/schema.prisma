// ============================================================
// LIVO — Schema do Banco de Dados
// Prisma + PostgreSQL (Railway)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────

// Planos disponíveis no sistema
enum Plan {
  start
  pro
  prime
}

// Status possíveis de um agendamento
enum AppointmentStatus {
  pending // aguardando confirmação
  confirmed // confirmado
  completed // atendimento realizado
  cancelled // cancelado
  no_show // cliente não compareceu
}

// ─── AUTH.JS (NextAuth) — tabelas obrigatórias ───────────────
// Essas 4 tabelas são exigidas pelo Auth.js Prisma Adapter
// Não altere os nomes dos campos — o Auth.js depende deles

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // senha criptografada (para login email+senha)

  accounts   Account[]
  sessions   Session[]
  barbershop Barbershop? // barbearia que este usuário é dono

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── LIVO — Modelos principais ───────────────────────────────

model Barbershop {
  id           String  @id @default(cuid())
  name         String // "Barbearia do João"
  slug         String  @unique // "barbearia-do-joao" → livo.com.br/barbearia-do-joao
  description  String?
  logoUrl      String?
  primaryColor String  @default("#FF2D55") // cor de destaque da página pública
  phone        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?

  // Plano e status
  plan          Plan      @default(start)
  planExpiresAt DateTime? // null = trial ativo
  isActive      Boolean   @default(true)

  // Dono da barbearia
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  // Relacionamentos
  professionals Professional[]
  services      Service[]
  appointments  Appointment[]
  clients       Client[]
  businessHours BusinessHour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barbershops")
}

model Professional {
  id        String  @id @default(cuid())
  name      String
  bio       String?
  avatarUrl String?
  isActive  Boolean @default(true)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("professionals")
}

model Service {
  id           String  @id @default(cuid())
  name         String // "Corte Social"
  description  String?
  durationMin  Int // duração em minutos (ex: 30, 45, 60)
  priceInCents Int // preço em centavos (R$40,00 = 4000)
  isActive     Boolean @default(true)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model Appointment {
  id      String            @id @default(cuid())
  date    DateTime // data e hora de início do agendamento
  endTime DateTime // data e hora de término (calculado)
  status  AppointmentStatus @default(pending)
  notes   String? // observações do agendamento

  // Dados do cliente (não precisa ter conta no sistema)
  clientName  String
  clientPhone String
  clientEmail String?

  // Relacionamentos
  barbershopId   String
  barbershop     Barbershop   @relation(fields: [barbershopId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  clientId       String? // opcional — vincula ao CRM se cliente existir
  client         Client?      @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointments")
}

model Client {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?
  notes String? // observações sobre o cliente

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  // Métricas calculadas (atualizadas a cada agendamento)
  totalVisits Int       @default(0)
  lastVisitAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mesmo telefone não pode estar duplicado na mesma barbearia
  @@unique([phone, barbershopId])
  @@map("clients")
}

model BusinessHour {
  id        String  @id @default(cuid())
  dayOfWeek Int // 0=Domingo, 1=Segunda, 2=Terça, ..., 6=Sábado
  openTime  String // "09:00"
  closeTime String // "18:00"
  isOpen    Boolean @default(true)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  // Cada dia da semana aparece uma vez por barbearia
  @@unique([dayOfWeek, barbershopId])
  @@map("business_hours")
}
