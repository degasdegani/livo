generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String       @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  birthDate       DateTime?
  cpf             String?      @unique
  accounts        Account[]
  barbershop      Barbershop?  @relation("BarbershopOwner")
  sentInvitations Invitation[] @relation("InvitedBy")
  memberships     Membership[]
  sessions        Session[]
  termsAcceptances TermsAcceptance[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Barbershop {
  id                  String            @id @default(cuid())
  name                String
  slug                String            @unique
  phone               String?
  city                String?
  state               String?
  coverPhotoUrl       String?
  logoUrl             String?
  plan                Plan              @default(start)
  isActive            Boolean           @default(true)
  ownerId             String            @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  asaasCustomerId     String?
  asaasSubscriptionId String?           @unique
  planStatus          PlanStatus        @default(trial)
  trialEndsAt         DateTime?
  lastBillingEventAt  DateTime?
  cep                 String?
  neighborhood        String?
  street              String?
  reopenPin           String?
  tvPin               String?           @unique
  clubEnabled         Boolean           @default(false)
  seatLimitOverride   Int?
  moduleAddOns        String[]          @default([])
  clubAsaasWalletId      String?
  clubAsaasAccountStatus String?
  appointments        Appointment[]
  owner               User              @relation("BarbershopOwner", fields: [ownerId], references: [id])
  businessHours       BusinessHour[]
  clients             Client[]
  comandas            Comanda[]
  invitations         Invitation[]
  memberships         Membership[]
  productCategories   ProductCategory[]
  products            Product[]
  professionals       Professional[]
  services            Service[]
  stockMovements      StockMovement[]
  timeBlocks          TimeBlock[]

  @@map("barbershops")
}

model Professional {
  id                   String        @id @default(cuid())
  name                 String
  bio                  String?
  avatarUrl            String?
  isActive             Boolean       @default(true)
  barbershopId         String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  commissionOnServices Boolean       @default(false)
  commissionOnProducts Boolean       @default(false)
  commissionServicePct Decimal?      @db.Decimal(5, 2)
  commissionProductPct Decimal?      @db.Decimal(5, 2)
  appointments         Appointment[]
  comandas             Comanda[]
  membership           Membership?
  serviceCommissions   ProfessionalServiceCommission[]
  productCommissions   ProfessionalProductCommission[]
  timeBlocks           TimeBlock[]
  barbershop           Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("professionals")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  durationMin  Int           @default(30)
  priceInCents Int           @default(0)
  isActive     Boolean       @default(true)
  barbershopId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments            Appointment[]
  comandaItems            ComandaItem[]
  comboItems              ComboItem[]
  appointmentServices     AppointmentService[]
  professionalCommissions ProfessionalServiceCommission[]
  subscriptionPlanItems   SubscriptionPlanItem[]
  barbershop              Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("services")
}

model Client {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  notes        String?
  barbershopId String
  totalVisits  Int           @default(0)
  lastVisitAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  birthDate    DateTime?
  bloqueado    Boolean       @default(false)
  cep          String?
  cpf          String?
  neighborhood String?
  origem       ClientOrigem?
  street       String?
  appointments Appointment[]
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  comandas     Comanda[]
  subscriptions ClientSubscription[]

  @@unique([phone, barbershopId])
  @@index([barbershopId])
  @@map("clients")
}

model Appointment {
  id             String            @id @default(cuid())
  date           DateTime
  endTime        DateTime?
  status         AppointmentStatus @default(pending)
  notes          String?
  clientName     String
  clientPhone    String?
  clientEmail    String?
  barbershopId   String
  professionalId String
  serviceId      String
  clientId       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  barbershop     Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  client         Client?           @relation(fields: [clientId], references: [id])
  professional   Professional      @relation(fields: [professionalId], references: [id])
  service        Service             @relation(fields: [serviceId], references: [id])
  comanda        Comanda?
  services       AppointmentService[]

  // WhatsApp — timestamps de notificação
  notificationSentAt  DateTime?
  reminderSentAt      DateTime?
  noShowReportedAt    DateTime?

  @@index([barbershopId])
  @@index([barbershopId, date])
  @@index([professionalId, date, endTime])
  @@map("appointments")
}

// Tabela de junção para múltiplos serviços por agendamento.
// serviceId é opcional + snapshots desnormalizados (mesmo padrão de ComandaItem):
// se o Service for editado/excluído depois, o histórico do agendamento permanece intacto.
model AppointmentService {
  id                  String      @id @default(cuid())
  appointmentId       String
  serviceId           String?
  serviceName         String
  servicePriceInCents Int
  serviceDurationMin  Int
  createdAt           DateTime    @default(now())

  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service             Service?    @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
  @@map("appointment_services")
}

model TimeBlock {
  id             String       @id @default(cuid())
  professionalId String
  barbershopId   String
  date           DateTime
  endTime        DateTime
  reason         String?
  createdAt      DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  barbershop     Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([professionalId, date])
  @@map("time_blocks")
}

model BusinessHour {
  id           String     @id @default(cuid())
  dayOfWeek    Int
  openTime     String     @default("09:00")
  closeTime    String     @default("18:00")
  isOpen       Boolean    @default(true)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([dayOfWeek, barbershopId])
  @@index([barbershopId])
  @@map("business_hours")
}

model Membership {
  id                   String        @id @default(cuid())
  role                 MemberRole
  userId               String
  barbershopId         String
  professionalId       String?       @unique(map: "Membership_professionalId_key")
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  barbershop           Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professional         Professional? @relation(fields: [professionalId], references: [id])
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
  @@unique([userId, barbershopId], map: "Membership_userId_barbershopId_key")
  @@index([barbershopId])
  @@map("memberships")
}

model Invitation {
  id                   String           @id @default(cuid())
  email                String
  role                 MemberRole
  token                String           @unique(map: "Invitation_token_key")
  status               InvitationStatus @default(pending)
  expiresAt            DateTime
  professionalId       String?
  commissionOnServices Boolean          @default(false)
  commissionOnProducts Boolean          @default(false)
  barbershopId         String
  invitedById          String?
  createdAt            DateTime         @default(now())
  acceptedAt           DateTime?
  barbershop           Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  invitedBy            User?            @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([barbershopId])
  @@map("invitations")
}

model WaitlistLead {
  id             String   @id @default(cuid())
  name           String
  whatsapp       String
  email          String
  barbershopName String?
  source         String   @default("vip")
  createdAt      DateTime @default(now())

  @@map("waitlist_leads")
}

model ProductCategory {
  id           String     @id @default(cuid())
  name         String
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([name, barbershopId])
  @@index([barbershopId])
  @@map("product_categories")
}

model Product {
  id             String           @id @default(cuid())
  name           String
  description    String?
  costInCents    Int              @default(0)
  priceInCents   Int              @default(0)
  stockQuantity  Int              @default(0)
  minStockAlert  Int              @default(5)
  isActive       Boolean          @default(true)
  barbershopId   String
  categoryId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  comandaItems            ComandaItem[]
  comboItems              ComboItem[]
  professionalCommissions ProfessionalProductCommission[]
  subscriptionPlanProductDiscounts SubscriptionPlanProductDiscount[]
  barbershop              Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  category                ProductCategory? @relation(fields: [categoryId], references: [id])
  stockMovements          StockMovement[]

  @@index([barbershopId])
  @@map("products")
}

model StockMovement {
  id           String              @id @default(cuid())
  quantity     Int
  reason       StockMovementReason
  notes        String?
  productId    String
  barbershopId String
  createdAt    DateTime            @default(now())
  barbershop   Barbershop          @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("stock_movements")
}

model Comanda {
  id             String         @id @default(cuid())
  status         ComandaStatus  @default(open)
  paymentMethod  PaymentMethod?
  clientId       String?
  clientName     String         @default("")
  notes          String?
  totalInCents   Int            @default(0)
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  barbershopId   String
  professionalId String
  appointmentId  String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          ComandaItem[]
  payments       ComandaPayment[]
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id])
  barbershop     Barbershop     @relation(fields: [barbershopId], references: [id])
  client         Client?        @relation(fields: [clientId], references: [id])
  professional   Professional   @relation(fields: [professionalId], references: [id])

  @@index([barbershopId])
  @@index([barbershopId, closedAt])
  @@index([barbershopId, status])
  @@map("comandas")
}

model ComandaPayment {
  id            String        @id @default(cuid())
  comandaId     String
  method        PaymentMethod
  amountInCents Int
  createdAt     DateTime      @default(now())
  comanda       Comanda       @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  @@index([comandaId])
  @@map("comanda_payments")
}

model ComandaItem {
  id               String          @id @default(cuid())
  type             ComandaItemType
  serviceId        String?
  serviceName      String          @default("")
  servicePrice     Int             @default(0)
  productId        String?
  productName      String          @default("")
  productPrice     Int             @default(0)
  quantity         Int
  unitPriceInCents Int
  totalInCents     Int
  commissionPct    Decimal?        @db.Decimal(5, 2)
  commissionValue  Int?
  comandaId        String
  comboId          String?
  clientSubscriptionId String?
  comanda          Comanda         @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  combo            Combo?          @relation(fields: [comboId], references: [id], onDelete: SetNull)
  clientSubscription   ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id], onDelete: SetNull)
  product          Product?        @relation(fields: [productId], references: [id])
  service          Service?        @relation(fields: [serviceId], references: [id])

  @@map("comanda_items")
}

model Combo {
  id                String        @id @default(cuid())
  barbershopId      String
  name              String
  description       String?
  priceInCents      Int
  commissionPercent Float?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             ComboItem[]
  comandaItems      ComandaItem[]

  @@index([barbershopId])
  @@map("combos")
}

model ComboItem {
  id        String          @id @default(cuid())
  comboId   String
  type      ComandaItemType
  serviceId String?
  productId String?
  quantity  Int             @default(1)
  combo     Combo           @relation(fields: [comboId], references: [id], onDelete: Cascade)
  service   Service?        @relation(fields: [serviceId], references: [id])
  product   Product?        @relation(fields: [productId], references: [id])

  @@index([comboId])
  @@map("combo_items")
}

model InsightDismissal {
  id           String   @id @default(cuid())
  barbershopId String
  recId        String
  dismissedAt  DateTime @default(now())

  @@unique([barbershopId, recId])
  @@index([barbershopId])
  @@map("insight_dismissals")
}

model ProfessionalServiceCommission {
  id             String       @id @default(cuid())
  professionalId String
  serviceId      String
  commissionPct  Decimal      @db.Decimal(5, 2)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@map("professional_service_commissions")
}

model ProfessionalProductCommission {
  id             String       @id @default(cuid())
  professionalId String
  productId      String
  commissionPct  Decimal      @db.Decimal(5, 2)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([professionalId, productId])
  @@map("professional_product_commissions")
}

enum Plan {
  start
  pro
  prime
}

enum PlanStatus {
  trial
  active
  suspended
  cancelled
  lifetime
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum MemberRole {
  owner
  reception
  barber
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum ClientOrigem {
  Indicacao
  Google
  Instagram
  Fachada
  Outro
}

enum StockMovementReason {
  purchase
  comanda_use
  manual_adjustment
  loss
  return
}

enum ComandaStatus {
  open
  closed
  cancelled
}

enum PaymentMethod {
  cash
  pix
  credit_card
  debit_card
  voucher
  cortesia
  convenio
  outros
}

enum ComandaItemType {
  service
  product
}

enum GoalPeriod {
  DAY
  WEEK
  MONTH
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model TermsAcceptance {
  id           String   @id @default(cuid())
  userId       String
  documentType String
  version      String
  acceptedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("terms_acceptances")
}

model BarbershopGoal {
  id            String     @id @default(cuid())
  barbershopId  String
  period        GoalPeriod
  targetInCents Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([barbershopId, period])
  @@index([barbershopId])
  @@map("barbershop_goals")
}

model ProfessionalGoal {
  id             String     @id @default(cuid())
  barbershopId   String
  professionalId String
  period         GoalPeriod
  targetServices Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([professionalId, period])
  @@index([barbershopId])
  @@map("professional_goals")
}

model TvDevice {
  id           String    @id @default(cuid())
  barbershopId String
  token        String    @unique
  label        String?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([barbershopId])
  @@map("tv_devices")
}

enum BarberCommissionMode {
  fixed
  none
}

model SubscriptionPlan {
  id                   String                            @id @default(cuid())
  barbershopId         String
  name                 String
  description          String?
  priceInCents         Int
  billingCycle         String                            @default("monthly")
  barberCommissionMode BarberCommissionMode              @default(none)
  platformFeePct       Float?
  maxSlots             Int?
  isActive             Boolean                           @default(true)
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  items                SubscriptionPlanItem[]
  productDiscounts     SubscriptionPlanProductDiscount[]
  subscriptions        ClientSubscription[]

  @@index([barbershopId])
  @@map("subscription_plans")
}

model SubscriptionPlanItem {
  id                      String           @id @default(cuid())
  planId                  String
  serviceId               String
  quantityPerCycle        Int              @default(1)
  barberCommissionInCents Int?
  plan                    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  service                 Service          @relation(fields: [serviceId], references: [id])

  @@index([planId])
  @@map("subscription_plan_items")
}

model SubscriptionPlanProductDiscount {
  id              String           @id @default(cuid())
  planId          String
  productId       String
  discountPct     Float?
  discountInCents Int?
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id])

  @@index([planId])
  @@map("subscription_plan_product_discounts")
}

enum ClientSubscriptionStatus {
  pending
  active
  suspended
  cancelled
}

model ClientSubscription {
  id                   String                   @id @default(cuid())
  barbershopId         String
  clientId             String
  planId               String
  status               ClientSubscriptionStatus @default(pending)
  asaasSubscriptionId  String?                  @unique
  soldByProfessionalId String?
  startedAt            DateTime?
  currentPeriodEnd     DateTime?
  cancelledAt          DateTime?
  lastBillingEventAt   DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  plan                 SubscriptionPlan         @relation(fields: [planId], references: [id])
  client               Client                   @relation(fields: [clientId], references: [id])
  usages               SubscriptionUsage[]
  comandaItems         ComandaItem[]

  @@index([barbershopId])
  @@index([clientId])
  @@map("client_subscriptions")
}

model SubscriptionUsage {
  id             String             @id @default(cuid())
  subscriptionId String
  serviceId      String
  periodStart    DateTime
  periodEnd      DateTime
  usedCount      Int                @default(0)
  subscription   ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_usages")
}

model ClientVerificationCode {
  id           String    @id @default(cuid())
  barbershopId String
  phone        String
  codeHash     String
  expiresAt    DateTime
  attempts     Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([barbershopId, phone])
  @@map("client_verification_codes")
}
