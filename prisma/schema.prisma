// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Plan {
  start
  pro
  prime
}

enum PlanStatus {
  trial
  active
  suspended
  cancelled
  lifetime
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum AppointmentOrigin {
  reception
  app
  owner
}

enum MemberRole {
  owner
  reception
  barber
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum ClientOrigem {
  Indicacao
  Google
  Instagram
  Fachada
  Outro
}

// ─── AUTH.JS ─────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  cpf           String?   @unique
  birthDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  barbershop      Barbershop?  @relation("BarbershopOwner")
  memberships     Membership[]
  sentInvitations Invitation[] @relation("InvitedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── BARBERSHOP ──────────────────────────────────────────────────────────────

model Barbershop {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  phone               String?
  city                String?
  state               String?
  street              String?
  neighborhood        String?
  cep                 String?
  plan                Plan      @default(start)
  planStatus          PlanStatus @default(trial)
  trialEndsAt         DateTime?
  asaasCustomerId     String?
  asaasSubscriptionId String?
  isActive            Boolean   @default(true)
  ownerId             String    @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  owner             User              @relation("BarbershopOwner", fields: [ownerId], references: [id])
  professionals     Professional[]
  services          Service[]
  appointments      Appointment[]
  clients           Client[]
  businessHours     BusinessHour[]
  memberships       Membership[]
  invitations       Invitation[]
  productCategories ProductCategory[]
  products          Product[]
  stockMovements    StockMovement[]
  comandas          Comanda[]

  @@map("barbershops")
}

// ─── PROFESSIONAL ────────────────────────────────────────────────────────────

model Professional {
  id           String   @id @default(cuid())
  name         String
  bio          String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  barbershopId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  membership   Membership?
  comandas     Comanda[]

  @@index([barbershopId])
  @@map("professionals")
}

// ─── SERVICE ─────────────────────────────────────────────────────────────────

model Service {
  id           String   @id @default(cuid())
  name         String
  description  String?
  durationMin  Int      @default(30)
  priceInCents Int      @default(0)
  isActive     Boolean  @default(true)
  barbershopId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop          Barbershop           @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  comandaItems        ComandaItem[]
  appointmentServices AppointmentService[]

  @@index([barbershopId])
  @@map("services")
}

// ─── CLIENT ──────────────────────────────────────────────────────────────────

model Client {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  notes        String?
  barbershopId String
  totalVisits  Int           @default(0)
  lastVisitAt  DateTime?
  cpf          String?
  birthDate    DateTime?
  street       String?
  neighborhood String?
  cep          String?
  origem       ClientOrigem?
  bloqueado    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  comandas     Comanda[]

  @@unique([phone, barbershopId])
  @@index([barbershopId])
  @@map("clients")
}

// ─── APPOINTMENT ─────────────────────────────────────────────────────────────

model Appointment {
  id             String            @id @default(cuid())
  date           DateTime
  endTime        DateTime?
  status         AppointmentStatus @default(pending)
  createdVia     AppointmentOrigin @default(reception)
  notes          String?
  clientName     String
  clientPhone    String?
  clientEmail    String?
  barbershopId   String
  professionalId String
  serviceId      String
  clientId       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  barbershop          Barbershop           @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professional        Professional         @relation(fields: [professionalId], references: [id])
  service             Service              @relation(fields: [serviceId], references: [id])
  client              Client?              @relation(fields: [clientId], references: [id])
  comanda             Comanda?
  appointmentServices AppointmentService[]

  @@index([barbershopId])
  @@map("appointments")
}

// ─── APPOINTMENT SERVICES (N serviços por agendamento) ───────────────────────

model AppointmentService {
  id            String   @id @default(cuid())
  appointmentId String
  serviceId     String
  priceInCents  Int      @default(0)
  durationMin   Int      @default(30)
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@map("appointment_services")
}

// ─── BUSINESS HOURS ──────────────────────────────────────────────────────────

model BusinessHour {
  id           String  @id @default(cuid())
  dayOfWeek    Int
  openTime     String  @default("09:00")
  closeTime    String  @default("18:00")
  isOpen       Boolean @default(true)
  barbershopId String

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([dayOfWeek, barbershopId])
  @@index([barbershopId])
  @@map("business_hours")
}

// ─── MEMBERSHIP ──────────────────────────────────────────────────────────────

model Membership {
  id                   String     @id @default(cuid())
  role                 MemberRole
  userId               String
  barbershopId         String
  professionalId       String?    @unique
  commissionOnServices Boolean    @default(false)
  commissionOnProducts Boolean    @default(false)
  commissionServicePct Decimal?   @db.Decimal(5, 2)
  commissionProductPct Decimal?   @db.Decimal(5, 2)
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@unique([userId, barbershopId])
  @@index([barbershopId])
  @@map("memberships")
}

// ─── INVITATION ──────────────────────────────────────────────────────────────

model Invitation {
  id                   String           @id @default(cuid())
  email                String
  role                 MemberRole
  token                String           @unique
  status               InvitationStatus @default(pending)
  expiresAt            DateTime
  professionalId       String?
  commissionOnServices Boolean          @default(false)
  commissionOnProducts Boolean          @default(false)
  barbershopId         String
  invitedById          String?
  createdAt            DateTime         @default(now())
  acceptedAt           DateTime?

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  invitedBy  User?      @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([barbershopId])
  @@map("invitations")
}

// ─── WAITLIST LEAD ────────────────────────────────────────────────────────────
// ⚠️ TEM 14 REGISTROS REAIS DO WORKSHOP TX — NUNCA DELETAR

model WaitlistLead {
  id             String   @id @default(cuid())
  name           String
  whatsapp       String
  email          String
  barbershopName String?
  source         String   @default("vip")
  createdAt      DateTime @default(now())

  @@map("waitlist_leads")
}

// ─── PRODUTOS & ESTOQUE ───────────────────────────────────────────────────────

enum StockMovementReason {
  purchase
  comanda_use
  manual_adjustment
  loss
  return
}

model ProductCategory {
  id           String   @id @default(cuid())
  name         String
  barbershopId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([name, barbershopId])
  @@index([barbershopId])
  @@map("product_categories")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?
  costInCents   Int      @default(0)
  priceInCents  Int      @default(0)
  stockQuantity Int      @default(0)
  minStockAlert Int      @default(5)
  isActive      Boolean  @default(true)
  barbershopId  String
  categoryId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  barbershop     Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  comandaItems   ComandaItem[]

  @@index([barbershopId])
  @@map("products")
}

model StockMovement {
  id           String              @id @default(cuid())
  quantity     Int
  reason       StockMovementReason
  notes        String?
  productId    String
  barbershopId String
  createdAt    DateTime            @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("stock_movements")
}

// ─── COMANDAS (PDV) ───────────────────────────────────────────────────────────

enum ComandaStatus {
  open
  closed
  cancelled
}

enum PaymentMethod {
  cash
  pix
  credit_card
  debit_card
  voucher
  cortesia
  convenio
  outros
}

enum ComandaItemType {
  service
  product
}

model Comanda {
  id                     String         @id @default(cuid())
  status                 ComandaStatus  @default(open)
  paymentMethod          PaymentMethod?
  clientId               String?
  clientName             String         @default("")
  notes                  String?
  totalInCents           Int            @default(0)
  serviceDiscountInCents Int            @default(0)
  productDiscountInCents Int            @default(0)
  openedAt               DateTime       @default(now())
  closedAt               DateTime?
  barbershopId           String
  professionalId         String
  appointmentId          String?        @unique
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  barbershop   Barbershop       @relation(fields: [barbershopId], references: [id])
  professional Professional     @relation(fields: [professionalId], references: [id])
  appointment  Appointment?     @relation(fields: [appointmentId], references: [id])
  client       Client?          @relation(fields: [clientId], references: [id])
  items        ComandaItem[]
  payments     ComandaPayment[]

  @@index([barbershopId])
  @@map("comandas")
}

model ComandaItem {
  id   String          @id @default(cuid())
  type ComandaItemType

  serviceId    String?
  serviceName  String  @default("")
  servicePrice Int     @default(0)

  productId    String?
  productName  String  @default("")
  productPrice Int     @default(0)

  quantity         Int
  unitPriceInCents Int
  totalInCents     Int

  commissionPct   Decimal? @db.Decimal(5, 2)
  commissionValue Int?

  comandaId String

  comanda Comanda  @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@map("comanda_items")
}

// ─── PAGAMENTOS DA COMANDA (N formas de pagamento por comanda) ────────────────

model ComandaPayment {
  id           String        @id @default(cuid())
  comandaId    String
  method       PaymentMethod
  valueInCents Int
  createdAt    DateTime      @default(now())

  comanda Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  @@map("comanda_payments")
}
