// ============================================================
// LIVO — Schema do Banco de Dados
// Prisma + PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────

enum Plan {
  start
  pro
  prime
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

// ─── AUTH.JS (NextAuth) ─────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  accounts   Account[]
  sessions   Session[]
  barbershop Barbershop?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── LIVO — MODELOS PRINCIPAIS ──────────────────────────────

model Barbershop {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  phone String?
  city  String?
  state String?

  // Plano
  plan Plan @default(start)

  // Status da assinatura
  planStatus          String    @default("trial")
  trialEndsAt         DateTime?
  asaasCustomerId     String?
  asaasSubscriptionId String?

  isActive Boolean @default(true)

  // Dono
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  // Relacionamentos
  professionals Professional[]
  services      Service[]
  appointments  Appointment[]
  clients       Client[]
  businessHours BusinessHour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barbershops")
}

model Professional {
  id        String  @id @default(cuid())
  name      String
  bio       String?
  avatarUrl String?
  isActive  Boolean @default(true)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("professionals")
}

model Service {
  id           String  @id @default(cuid())
  name         String
  description  String?
  durationMin  Int
  priceInCents Int
  isActive     Boolean @default(true)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model Appointment {
  id      String            @id @default(cuid())
  date    DateTime
  endTime DateTime
  status  AppointmentStatus @default(pending)
  notes   String?

  // Cliente
  clientName  String
  clientPhone String
  clientEmail String?

  // Relacionamentos
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointments")
}

model Client {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?
  notes String?

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  // Métricas
  totalVisits Int       @default(0)
  lastVisitAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, barbershopId])
  @@map("clients")
}

model BusinessHour {
  id        String  @id @default(cuid())
  dayOfWeek Int
  openTime  String
  closeTime String
  isOpen    Boolean @default(true)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([dayOfWeek, barbershopId])
  @@map("business_hours")
}
