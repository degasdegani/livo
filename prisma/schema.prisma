generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String       @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  birthDate       DateTime?
  cpf             String?      @unique
  accounts        Account[]
  barbershop      Barbershop?  @relation("BarbershopOwner")
  sentInvitations Invitation[] @relation("InvitedBy")
  memberships     Membership[]
  sessions        Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Barbershop {
  id                  String            @id @default(cuid())
  name                String
  slug                String            @unique
  phone               String?
  city                String?
  state               String?
  plan                Plan              @default(start)
  isActive            Boolean           @default(true)
  ownerId             String            @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  asaasCustomerId     String?
  asaasSubscriptionId String?
  planStatus          PlanStatus        @default(trial)
  trialEndsAt         DateTime?
  cep                 String?
  neighborhood        String?
  street              String?
  appointments        Appointment[]
  owner               User              @relation("BarbershopOwner", fields: [ownerId], references: [id])
  businessHours       BusinessHour[]
  clients             Client[]
  comandas            Comanda[]
  invitations         Invitation[]
  memberships         Membership[]
  productCategories   ProductCategory[]
  products            Product[]
  professionals       Professional[]
  services            Service[]
  stockMovements      StockMovement[]

  @@map("barbershops")
}

model Professional {
  id           String        @id @default(cuid())
  name         String
  bio          String?
  avatarUrl    String?
  isActive     Boolean       @default(true)
  barbershopId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  comandas     Comanda[]
  membership   Membership?
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("professionals")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  durationMin  Int           @default(30)
  priceInCents Int           @default(0)
  isActive     Boolean       @default(true)
  barbershopId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  comandaItems ComandaItem[]
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("services")
}

model Client {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  notes        String?
  barbershopId String
  totalVisits  Int           @default(0)
  lastVisitAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  birthDate    DateTime?
  bloqueado    Boolean       @default(false)
  cep          String?
  cpf          String?
  neighborhood String?
  origem       ClientOrigem?
  street       String?
  appointments Appointment[]
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  comandas     Comanda[]

  @@unique([phone, barbershopId])
  @@index([barbershopId])
  @@map("clients")
}

model Appointment {
  id             String            @id @default(cuid())
  date           DateTime
  endTime        DateTime?
  status         AppointmentStatus @default(pending)
  notes          String?
  clientName     String
  clientPhone    String?
  clientEmail    String?
  barbershopId   String
  professionalId String
  serviceId      String
  clientId       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  barbershop     Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  client         Client?           @relation(fields: [clientId], references: [id])
  professional   Professional      @relation(fields: [professionalId], references: [id])
  service        Service           @relation(fields: [serviceId], references: [id])
  comanda        Comanda?

  @@index([barbershopId])
  @@index([barbershopId, date])
  @@index([professionalId, date, endTime])
  @@map("appointments")
}

model BusinessHour {
  id           String     @id @default(cuid())
  dayOfWeek    Int
  openTime     String     @default("09:00")
  closeTime    String     @default("18:00")
  isOpen       Boolean    @default(true)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([dayOfWeek, barbershopId])
  @@index([barbershopId])
  @@map("business_hours")
}

model Membership {
  id                   String        @id @default(cuid())
  role                 MemberRole
  userId               String
  barbershopId         String
  professionalId       String?       @unique(map: "Membership_professionalId_key")
  commissionOnServices Boolean       @default(false)
  commissionOnProducts Boolean       @default(false)
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  commissionServicePct Decimal?      @db.Decimal(5, 2)
  commissionProductPct Decimal?      @db.Decimal(5, 2)
  barbershop           Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professional         Professional? @relation(fields: [professionalId], references: [id])
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
  @@unique([userId, barbershopId], map: "Membership_userId_barbershopId_key")
  @@index([barbershopId])
  @@map("memberships")
}

model Invitation {
  id                   String           @id @default(cuid())
  email                String
  role                 MemberRole
  token                String           @unique(map: "Invitation_token_key")
  status               InvitationStatus @default(pending)
  expiresAt            DateTime
  professionalId       String?
  commissionOnServices Boolean          @default(false)
  commissionOnProducts Boolean          @default(false)
  barbershopId         String
  invitedById          String?
  createdAt            DateTime         @default(now())
  acceptedAt           DateTime?
  barbershop           Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  invitedBy            User?            @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([barbershopId])
  @@map("invitations")
}

model WaitlistLead {
  id             String   @id @default(cuid())
  name           String
  whatsapp       String
  email          String
  barbershopName String?
  source         String   @default("vip")
  createdAt      DateTime @default(now())

  @@map("waitlist_leads")
}

model ProductCategory {
  id           String     @id @default(cuid())
  name         String
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([name, barbershopId])
  @@index([barbershopId])
  @@map("product_categories")
}

model Product {
  id             String           @id @default(cuid())
  name           String
  description    String?
  costInCents    Int              @default(0)
  priceInCents   Int              @default(0)
  stockQuantity  Int              @default(0)
  minStockAlert  Int              @default(5)
  isActive       Boolean          @default(true)
  barbershopId   String
  categoryId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  comandaItems   ComandaItem[]
  barbershop     Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  stockMovements StockMovement[]

  @@index([barbershopId])
  @@map("products")
}

model StockMovement {
  id           String              @id @default(cuid())
  quantity     Int
  reason       StockMovementReason
  notes        String?
  productId    String
  barbershopId String
  createdAt    DateTime            @default(now())
  barbershop   Barbershop          @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("stock_movements")
}

model Comanda {
  id             String         @id @default(cuid())
  status         ComandaStatus  @default(open)
  paymentMethod  PaymentMethod?
  clientId       String?
  clientName     String         @default("")
  notes          String?
  totalInCents   Int            @default(0)
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  barbershopId   String
  professionalId String
  appointmentId  String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          ComandaItem[]
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id])
  barbershop     Barbershop     @relation(fields: [barbershopId], references: [id])
  client         Client?        @relation(fields: [clientId], references: [id])
  professional   Professional   @relation(fields: [professionalId], references: [id])

  @@index([barbershopId])
  @@index([barbershopId, closedAt])
  @@index([barbershopId, status])
  @@map("comandas")
}

model ComandaItem {
  id               String          @id @default(cuid())
  type             ComandaItemType
  serviceId        String?
  serviceName      String          @default("")
  servicePrice     Int             @default(0)
  productId        String?
  productName      String          @default("")
  productPrice     Int             @default(0)
  quantity         Int
  unitPriceInCents Int
  totalInCents     Int
  commissionPct    Decimal?        @db.Decimal(5, 2)
  commissionValue  Int?
  comandaId        String
  comanda          Comanda         @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id])
  service          Service?        @relation(fields: [serviceId], references: [id])

  @@map("comanda_items")
}

model InsightDismissal {
  id           String   @id @default(cuid())
  barbershopId String
  recId        String
  dismissedAt  DateTime @default(now())

  @@unique([barbershopId, recId])
  @@index([barbershopId])
  @@map("insight_dismissals")
}

enum Plan {
  start
  pro
  prime
}

enum PlanStatus {
  trial
  active
  suspended
  cancelled
  lifetime
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum MemberRole {
  owner
  reception
  barber
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum ClientOrigem {
  Indicacao
  Google
  Instagram
  Fachada
  Outro
}

enum StockMovementReason {
  purchase
  comanda_use
  manual_adjustment
  loss
  return
}

enum ComandaStatus {
  open
  closed
  cancelled
}

enum PaymentMethod {
  cash
  pix
  credit_card
  debit_card
  voucher
  cortesia
  convenio
  outros
}

enum ComandaItemType {
  service
  product
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}
